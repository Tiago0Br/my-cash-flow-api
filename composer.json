{
    "name": "tiagolopes/my-cash-flow-api",
    "description": "API para sistema de gestão de finanças",
    "type": "project",
    "autoload": {
        "psr-4": {
            "Tiagolopes\\MyCashFlowApi\\": "src/"
        },
        "files": [
            "config/functions.php"
        ]
    },
    "authors": [
        {
            "name": "Tiago Lopes",
            "email": "tiagoltavares2002@gmail.com"
        }
    ],
    "require": {
        "php": "^8.4",
        "ext-pdo": "*",
        "zircote/swagger-php": "^5.1",
        "ramsey/uuid": "^4.9",
        "slim/slim": "4.*",
        "slim/psr7": "^1.8",
        "php-di/php-di": "^7.1",
        "robmorgan/phinx": "^0.16.12"
    },
    "scripts": {
        "serve": [
            "Composer\\Config::disableProcessTimeout",
            "php -S localhost:3000 -t ./public"
        ],
        "migrate": "phinx migrate",
        "rollback": "phinx rollback",
        "create-migration": "phinx create",
        "dev": [
            "@migrate",
            "@serve"
        ]
    },
    "require-dev": {
        "vlucas/phpdotenv": "^5.7"
    }
}
